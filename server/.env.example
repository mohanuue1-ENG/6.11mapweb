# Copy this file to .env and fill in the values. Never commit .env.

NODE_ENV=development
PORT=4000

# PostgreSQL connection string (Neon or any managed PostgreSQL).
# Leave empty in development to use an embedded PostgreSQL (PGlite) stored in ./.data
# Required in production. Suggested database name: 611_drive_gps
DATABASE_URL=
# Set to "false" only for a local PostgreSQL without TLS.
DATABASE_SSL=true

# Origin of the React website (comma-separated for several).
CLIENT_URL=http://localhost:3000

# Long random strings. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Required in production.
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Refresh cookie SameSite: "lax" when web and API share a site, "none" when they
# are on different sites (e.g. Vercel + Render). "none" forces Secure cookies.
COOKIE_SAMESITE=lax

BCRYPT_ROUNDS=12

# Used only by "npm run seed". Accounts are skipped when a password is empty.
# "Continue with Google": the OAuth client id from Google Cloud Console (leave empty to turn it off).
GOOGLE_CLIENT_ID=

SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=

# GPS ingestion. A batch larger than the size limit is refused; points older than
# the age limit or further in the future than the clock allowance are rejected.
GPS_MAX_BATCH_SIZE=500
GPS_MAX_POINT_AGE_DAYS=7
GPS_MAX_FUTURE_SECONDS=300

# Email. Any SMTP service works (Resend, Postmark, Gmail app password, your own server).
# Leave SMTP_HOST empty to send nothing: the admin screen then shows the sign-in link to hand over by hand.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=6.11 Drive GPS <no-reply@yourdomain.com>
# Where new access requests are announced by email.
ADMIN_NOTIFY_EMAIL=
# Public website address used in email links (defaults to the first CLIENT_URL).
APP_URL=
# Free trial given to an approved company.
TRIAL_DAYS=7

# A new company creates its account at once; its dashboard opens when it pays for a plan (set false to close sign-up).
ALLOW_SELF_REGISTRATION=true

# Online payment with Stripe (https://dashboard.stripe.com). Use test keys (sk_test_...) while testing.
# Create a webhook endpoint pointing to  <API address>/api/v1/signup/webhooks/stripe  for the events
# checkout.session.completed, invoice.paid, invoice.payment_failed, customer.subscription.deleted,
# and put its signing secret (whsec_...) below. Without a key, local development uses a fake checkout
# and production switches online sign-up off.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Place names for truck positions ("Interstate 35, Waco, Texas"). The server sends truck coordinates to
# this OpenStreetMap-compatible service. The public one allows about 1 request/second and needs a real
# contact in the User-Agent; for a larger fleet use a paid or self-hosted service. Empty = no place names.
GEOCODER_URL=https://nominatim.openstreetmap.org/reverse
GEOCODER_USER_AGENT=611-drive-gps/1.0 (contact: you@yourcompany.com)

# Driver sign-up and sign-in codes are emailed to the address on the driver profile. They switch on by themselves
# once email (SMTP above) is set up; DRIVER_LOGIN_CODES=false turns the sign-in code off.
# With Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASS=<a Google "app password">
# (Google account -> Security -> 2-Step Verification -> App passwords), MAIL_FROM="TRUKOVA <you@gmail.com>".
DRIVER_LOGIN_CODES=
# TEST ONLY: with no email set up, return the code in the API answer so the app can be tried. Not safe for real use.
CODE_TEST_MODE=
CODE_TTL_MINUTES=10
TRUSTED_DEVICE_DAYS=30

# A new company creates its account at once and signs in; its dashboard opens when it pays for a plan.
# Online payment needs STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET in production (local development uses a test checkout).
# REQUIRE_SUBSCRIPTION=true  (set to false only for tests)
